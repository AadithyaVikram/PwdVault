<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PwdVault.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Segoe UI" /></Style>
    <Style Selector="Button"><Setter Property="Padding" Value="16,10" /><Setter Property="CornerRadius" Value="7" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#66D9B4" /><Setter Property="Foreground" Value="#10251F" /></Style>
    <Style Selector="TextBox"><Setter Property="IsUndoEnabled" Value="False" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="12,10" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="#A9B8CC" /><Setter Property="FontSize" Value="12" /></Style>
  </Application.Styles>
</Application>
