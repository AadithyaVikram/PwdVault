<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/pwdvault.ico</ApplicationIcon>
    <Product>PwdVault</Product>
    <Title>PwdVault</Title>
    <Description>Offline password vault</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <ProjectReference Include="../PwdVault.Storage/PwdVault.Storage.csproj" />
    <ProjectReference Include="../PwdVault.Platform.Windows/PwdVault.Platform.Windows.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
</Project>
